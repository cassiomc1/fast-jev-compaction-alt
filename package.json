{
  "name": "fast-jev-compaction-alt",
  "version": "0.2.0",
  "description": "Continuous, verbatim context compaction for LLM agents using TypeSafe's Jev model.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cassiomc1/fast-jev-compaction-alt.git",
    "directory": ""
  },
  "bugs": {
    "url": "https://github.com/cassiomc1/fast-jev-compaction-alt/issues"
  },
  "homepage": "https://github.com/cassiomc1/fast-jev-compaction-alt#readme",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./server": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./opencode": {
      "types": "./dist/opencode.d.ts",
      "import": "./dist/opencode.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && npm run typecheck:hooks",
    "test": "vitest run",
    "demo": "tsx examples/demo.ts",
    "typecheck:hooks": "tsc -p tsconfig.hooks.json",
    "validate:plugin": "claude plugin validate .claude-plugin/plugin.json",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run check",
    "pack:check": "npm pack --dry-run",
    "smoke:pack": "node scripts/pack-smoke-test.mjs",
    "version:check": "node scripts/check-version-sync.mjs",
    "release:check": "npm run check && npm run validate:plugin && npm run pack:check && npm run smoke:pack"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.31",
    "@opencode-ai/sdk": "^1.18.31",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "claude-code",
    "compaction",
    "context-management",
    "typesafe",
    "jev"
  ]
}
